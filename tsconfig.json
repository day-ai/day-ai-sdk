{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "examples/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples/community-builder",
    "examples/desktop",
    "examples/desktop-claude-agent-sdk",
    "examples/mobile",
    "examples/vercel-weather-cron"
  ]
}