{
  "name": "day-ai-sdk",
  "version": "0.3.0",
  "description": "SDK for integrating with Day AI",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "day-ai": "./dist/cli/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "yarn install && yarn build && npm link && node dist/cli/cli.js doctor --no-network",
    "build": "tsc && chmod +x dist/cli/cli.js",
    "day-ai": "node dist/cli/cli.js",
    "dev": "tsc --watch",
    "oauth:setup": "node dist/scripts/oauth-setup.js",
    "example:mcp": "node dist/examples/mcp-tool-example.js",
    "example:meetings": "node dist/examples/recent-meetings-context.js",
    "example:pagination": "node dist/examples/pagination-example.js",
    "docs:tools": "yarn build && node dist/scripts/generate-tools-doc.js",
    "verify:parsing": "yarn build && node dist/scripts/verify-sse-parsing.js",
    "test": "yarn build && node dist/scripts/run-tests.js all",
    "test:tool": "yarn build && node dist/scripts/run-tests.js tool",
    "test:file": "yarn build && node dist/scripts/run-tests.js file",
    "test:unit": "yarn build && node --test dist/tests/unit/*.test.js"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/node": "^24.5.2",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "day-ai",
    "crm",
    "api",
    "sdk",
    "cli",
    "mcp"
  ],
  "author": "Day AI",
  "license": "MIT",
  "packageManager": "yarn@4.4.0+sha512.91d93b445d9284e7ed52931369bc89a663414e5582d00eea45c67ddc459a2582919eece27c412d6ffd1bd0793ff35399381cb229326b961798ce4f4cc60ddfdb"
}
